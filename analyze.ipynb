   "source": [
    "# Produce a simple scatter plot and save as PNG\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "df = pd.read_csv('merged_panel.csv')\n",
    "plt.figure(figsize=(6,4))\n",
    "plt.scatter(df['gdp_per_capita_usd'], df['diabetes_prevalence_pct'])\n",
    "plt.xscale('log')\n",
    "plt.xlabel('GDP per capita (log USD)')\n",
    "plt.ylabel('Diabetes prevalence (%)')\n",
    "plt.title('Diabetes prevalence vs GDP per capita')\n",
    "plt.tight_layout()\n",
    "plt.savefig('figures/diabetes_vs_gdp.png')\n",
    "plt.close()"
